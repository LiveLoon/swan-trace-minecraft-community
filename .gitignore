# =========================================================
# 鸿迹（Swan Trace）Minecraft 社区仓库 .gitignore
# =========================================================

# ---------- Minecraft 服务端运行时数据 ----------
# 日志、崩溃报告、缓存
logs/
crash-reports/
cache/

# 服务端运行库与版本缓存（可由 server.jar 重新下载）
libraries/
versions/

# 玩家状态数据（会频繁变动，且含玩家 UUID / IP 等）
banned-ips.json
banned-players.json
ops.json
whitelist.json
usercache.json
version_history.json

# 服务端 JAR（体积大，不建议进 Git；如需保留请用 Git LFS）
server.jar
server.jar.vallia
paper-*.jar
spigot-*.jar
*.jar
!gradle/wrapper/gradle-wrapper.jar

# EULA（每台机器可自行生成）
eula.txt

# ---------- 世界存档 ----------
# 存档体积巨大，建议用 Git LFS 或独立的 world-sync 工具同步
world/
world_nether/
world_the_end/
*.mca
*.mcr
*.dat_old
session.lock

# ---------- 敏感信息 / 密钥 ----------
# 千万不要把证书、私钥、后台凭证提交到公开仓库
ssl/
*.pem
*.key
*.crt
*.p12
*.jks
*.keystore
.env
.env.*
secrets/
opanel/
# 若 server.properties 含端口/RCON 密码，也建议忽略，改用模板
# server.properties

# ---------- 插件配置 ----------
# 插件配置常含数据库密码、Web 令牌等，按需忽略
# config/
# plugins/
# 但如果你想公开透明，可以保留并脱敏后提交

# ---------- Java / Maven / Gradle ----------
target/
build/
out/
.gradle/
*.class
*.log
hs_err_pid*.log
replay_pid*.log

# ---------- Node.js（网站前端） ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.next/
.nuxt/
dist/
.vite/
*.local

# ---------- Android（安卓端编译） ----------
app/build/
*.apk
*.aab
*.ap_
*.dex
local.properties
.cxx/

# ---------- IDE / 编辑器 ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
!.vscode/extensions.json
.settings/
.project
.classpath
*.swp
*.swo

# ---------- 操作系统 ----------
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ---------- 其他 ----------
*.tmp
*.bak
*.orig
*.rej


plugins/Residence/Backup/*



