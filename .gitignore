# ============================
*.tmp
*.old
*.log
*.log.gz
*.lock
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ============================
# IDE 和编辑器配置
# ============================
.idea/
*.iml
.vscode/
*.code-workspace
.settings/
.project
.classpath

# ============================
# 构建工具输出
# ============================
# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Gradle
.gradle/
build/
gradle-app.setting
!gradle-wrapper.jar

# ============================
# Minecraft 服务器特定
# ============================
# 日志目录（所有日志文件）
logs/
*.log.gz

# 备份目录
backups/

# 世界数据（体积巨大，不建议纳入版本控制）
world/
world_*/          # 包括 world_the_end, world_the_nether 等
DIM-*/
DIM*/
dimensions/
data/
advancements/
playerdata/
players/
stats/
region/
poi/
entities/
# 但保留 level.dat? 通常也不保留，但如果您需要记录世界种子等可保留，这里建议忽略全部
level.dat
level.dat_old
session.lock

# 插件数据（忽略所有 JAR 文件，但保留配置目录结构）
plugins/*.jar
plugins/**/*.jar
plugins/**/cache/      # 部分插件缓存
plugins/**/tmp/
plugins/**/*.db
plugins/**/*.mv.db

# 特定插件的数据目录（可根据实际情况调整）
plugins/BlueMap/maps/   # 地图渲染数据（通常很大）
plugins/BlueMap/storages/
plugins/Essentials/userdata/
plugins/Essentials/userdata-npc-backup/
plugins/LuckPerms/luckperms-h2-v2.mv.db
plugins/Residence/Backup/
plugins/Residence/Save/Backup/
plugins/Residence/Save/PlayerData/
plugins/NexoraStatistics/nexorastats.db

# 依赖库（Maven 本地仓库缓存）
libraries/

# 版本历史（服务器升级记录）
versions/
server.jar.vallia

# SSL 证书（私钥必须忽略）
ssl/server.key
ssl/server.crt   # 证书可选择性忽略

# 服务器运行时生成的其他文件
cache/
crash-reports/
opanel/mapdata/          # 地图数据（可能很大）
opanel/tasks.json

# Web 项目（前端/后端）构建输出
just-mc-official-webside/backend/target/
just-mc-official-webside/backend/.gradle/
just-mc-official-webside/frontend/node_modules/
just-mc-official-webside/frontend/dist/
just-mc-official-webside/frontend/.vite/
just-mc-official-webside/frontend/.cache/
just-mc-official-webside/frontend/.env.local
just-mc-official-webside/frontend/.env.*.local

# 编译生成的 JAR 包（除了您自己编写的源码，其他都忽略）
*.jar

# ============================
# 其他可能忽略的文件
# ============================
*.zip
*.gz
*.rar
*.7z
*.pem
*.key
*.crt
*.der
*.p12
*.pfx



# 个人配置文件
.bash_history
.bash_logout
.bash_profile
.bashrc
.viminfo
.cache/
.config/
.local/
.ssh/
.vim/
*.swp
Dockerfile.backup
logs/
crash-reports/
repository/*.properties

